{
  "name": "dmorenof/casafari-sdk",
  "description": "Unofficial PHP SDK for the Casafari CRM API, with typed DTOs, typed collections and HTTP middleware.",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "CasafariSDK\\": "src/"
    }
  },
  "require": {
    "php": ">=8.3",
    "typedarray/typedarray": "^1.0",
    "guzzlehttp/guzzle": "^7.9 || ^8.0",
    "alexanderpas/http-enum": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "keywords": [
    "casafari",
    "casafari-crm",
    "sdk",
    "php",
    "api-client",
    "real-estate"
  ],
  "homepage": "https://github.com/dmorenof/casafari-sdk",
  "authors": [
    {
      "name": "David Moreno Falero",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/dmorenof/casafari-sdk/issues",
    "source": "https://github.com/dmorenof/casafari-sdk"
  }
}
