{
  "name": "dmorenof/casafari-sdk",
  "description": "Unofficial PHP SDK for the Casafari REST API, generated from its OpenAPI contract with sdk-generator.",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "CasafariSDK\\": "src/",
      "CasafariSDK\\Middlewares\\": "lib/Middlewares/"
    }
  },
  "require": {
    "php": ">=8.4",
    "dmorenof/sdk-runtime": "^1.9.0"
  },
  "require-dev": {
    "dmorenof/sdk-generator": "^1.10.0",
    "phpunit/phpunit": "^11.5"
  },
  "keywords": [
    "casafari",
    "openapi",
    "sdk",
    "php",
    "api-client",
    "real-estate"
  ],
  "homepage": "https://github.com/dmorenof/casafari-sdk",
  "authors": [
    {
      "name": "David Moreno Falero",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/dmorenof/casafari-sdk/issues",
    "source": "https://github.com/dmorenof/casafari-sdk"
  },
  "autoload-dev": {
    "psr-4": {
      "CasafariSDK\\Tests\\": "Tests/"
    }
  },
  "scripts": {
    "regenerate": "@php bin/regenerate.php",
    "regenerate:check": "@php bin/regenerate.php --check",
    "test": "phpunit"
  }
}
